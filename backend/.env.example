# Kunci induk modul crypto_services (WAJIB, minimal 32 karakter). Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Jangan di-commit dan jangan diganti setelah ada data: data lama tidak akan bisa dibuka.
ROOT_KEY=
ROOT_KEY_VERSION=1

# Cipher yang dipakai menyimpan tiap item (satu baris `ciphertexts` per cipher):
# aes = AES-256-CTR+HMAC, des = DES-CTR+HMAC, rc4 = RC4.
CRYPTO_CIPHERS=aes,des,rc4

JWT_SECRET_KEY=

JWT_COOKIE_SECURE=false

DATABASE_PATH=data/schematics.db

STORAGE_DIR=storage

RATELIMIT_STORAGE_URI=memory://

APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
