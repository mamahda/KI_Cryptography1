# Copy to backend/.env and fill in SERVER_SECRET. Never commit .env.

# Local MariaDB (or MySQL 8). Create the database and user first; see README.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vault
DB_PASSWORD=vault
DB_NAME=vault

# Root secret for HKDF key derivation: 32 random bytes as hex.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing or losing it makes every stored record undecryptable.
SERVER_SECRET=

# Encrypted files go here (relative to backend/).
STORAGE_DIR=../storage

HOST=127.0.0.1
PORT=8080

# Set to true when served over HTTPS.
COOKIE_SECURE=false

SESSION_TTL_HOURS=24

# Optional: serve the built frontend from the same server.
# STATIC_DIR=../frontend/dist
