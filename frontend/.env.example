# Copy to .env inside frontend/ for local overrides. Never commit .env.

# Base URL prepended to API requests.
# Leave empty ("") in development so requests go to /api/* via Vite's same-origin proxy,
# allowing HttpOnly JWT + CSRF cookies (SameSite=Lax) to work seamlessly without CORS.
VITE_API_BASE_URL=

# Target Flask backend URL used by Vite's dev/preview /api proxy (matches root .env.example).
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Opt-in Mock Service Worker (MSW) mode for standalone frontend development & testing.
# Set to "true" to intercept /api/* in the browser with stateful mocks; "false" for live Flask.
VITE_ENABLE_MSW=false
