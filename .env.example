# Salin ke .env di root repo lalu isi. Jangan pernah commit .env.

# --- Kriptografi -------------------------------------------------------------

# Root key (KEK) 32 byte, base64. Membungkus semua kunci per item (AES-256-GCM)
# dan menurunkan kunci blind index email lewat HKDF.
# Buat dengan:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Mengganti atau kehilangan nilai ini membuat semua data tersimpan tidak bisa dibuka.
ROOT_KEY=

# --- Sesi (flask-jwt-extended) -----------------------------------------------

# Kunci tanda tangan JWT, terpisah dari ROOT_KEY. Menggantinya hanya
# membatalkan sesi yang sedang aktif, tidak menyentuh data.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# true jika disajikan lewat HTTPS; false untuk pengembangan di http://localhost.
JWT_COOKIE_SECURE=false

# --- Penyimpanan -------------------------------------------------------------

# File SQLite (mode WAL). Path relatif terhadap root repo.
DATABASE_PATH=data/schematics.db

# Folder ciphertext file (KTP, KTM/KRSM, twibbon, proposal, video) dan file
# sementara saat unggah. Isinya hanya ciphertext.
STORAGE_DIR=storage

# --- Rate limit (Flask-Limiter) ----------------------------------------------

# memory:// cukup untuk satu proses; pakai redis://... jika lebih dari satu worker.
RATELIMIT_STORAGE_URI=memory://

# --- Server Flask ------------------------------------------------------------

FLASK_DEBUG=true
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# --- Akun superadmin awal ----------------------------------------------------

# Dipakai sekali oleh skrip seed untuk membuat superadmin pertama, jika belum ada.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
