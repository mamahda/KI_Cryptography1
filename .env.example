# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# Root secret for HKDF key derivation: 32 random bytes as hex.
# Generate with: openssl rand -hex 32
# Changing or losing it makes every stored record undecryptable.
SERVER_SECRET=

DB_NAME=vault
DB_USER=vault
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Where the frontend container is published on the host. Keep 127.0.0.1 when a
# reverse proxy on the host (e.g. nginx on port 80) forwards to it.
APP_BIND=127.0.0.1
APP_PORT=3000

# Set to true when served over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
